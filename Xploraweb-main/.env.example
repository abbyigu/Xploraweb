# Supabase (public anon key — safe to expose in the browser; security is enforced via RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Analytics (leave empty to disable; Vite substitutes these into index.html at build time)
VITE_GTM_ID=GTM-XXXXXXX
VITE_GA4_ID=G-XXXXXXXXXX

# These are server-side only (set in Vercel dashboard, never commit values)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
