# Supabase (public anon key — safe to expose in the browser; security is enforced via RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Maps JavaScript API — powers every in-app map (neighbourhood/spot maps,
# admin boundary editor). Restrict this key by HTTP referrer (your domain +
# localhost) and to only the "Maps JavaScript API" — it is sent to the browser,
# unlike the server-only GOOGLE_MAPS_API_KEY below.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_js_api_key

# Optional: Firebase App Check (reCAPTCHA v3) for the Google Maps key above.
# Attaches an attestation token to every Maps JS request so the key can later
# be enforced against scraped-key abuse in Cloud Console. The app works fine
# without these — Maps just loads without the extra check. To set up:
#   1. Add Firebase to a project linked to the same Cloud project as the Maps
#      key (console.firebase.google.com), register a Web app there.
#   2. Register the site for reCAPTCHA v3 (google.com/recaptcha/admin) and
#      get its site key.
#   3. Enable App Check in the Firebase console, add the reCAPTCHA v3 site
#      key as its provider.
#   4. Fill in the values below from the Firebase web app config.
# https://developers.google.com/maps/documentation/javascript/dynamic-loading-app-check
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your_firebase_app_id
# VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com   # optional, defaults from project id
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key

# Analytics — GA4 ID is hardcoded in index.html (G-JF6LR3L9HH); no env var needed

# These are server-side only (set in Vercel dashboard, never commit values)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
# GOOGLE_MAPS_API_KEY=...   # Places API (New) enabled + billing on. Used by
#                           # scripts/fetch-google-place-ids.mjs and the
#                           # api/refresh-google-ratings.ts cron — never sent to the browser.
# CRON_SECRET=...           # Set in Vercel; Vercel Cron auto-sends it as a Bearer token
#                           # so only the scheduled job (not the public) can trigger the refresh.
