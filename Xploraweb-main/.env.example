# Supabase (public anon key — safe to expose in the browser; security is enforced via RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Maps use MapLibre + OpenFreeMap tiles: no API key or env var needed.

# Analytics — GA4 ID is hardcoded in index.html (G-JF6LR3L9HH); no env var needed

# These are server-side only (set in Vercel dashboard, never commit values)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
# RESEND_API_KEY=...
# GOOGLE_MAPS_API_KEY=...   # Places API (New) + Routes API enabled, billing on. Used by
#                           # scripts/fetch-google-place-ids.mjs, api/refresh-google-ratings.ts,
#                           # and api/_lib/googleRoutes.ts (confirms stop order against real
#                           # Google walking routes during itinerary generation) — never sent
#                           # to the browser. Itinerary generation still works without it —
#                           # it just falls back to straight-line distance for ordering.
# CRON_SECRET=...           # Set in Vercel; Vercel Cron auto-sends it as a Bearer token
#                           # so only the scheduled job (not the public) can trigger the refresh.
